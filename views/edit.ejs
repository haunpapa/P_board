<%- include('header') %>

<div class="form-page">
  <div class="form-header">
    <h1>글 수정</h1>
    <p class="form-desc">게시글 정보를 수정합니다</p>
  </div>

  <% if (typeof error !== 'undefined') { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/posts/<%= post.id %>" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="title">제목</label>
      <input type="text" id="title" name="title" required
             value="<%= post.title %>"
             placeholder="게시글 제목을 입력하세요">
    </div>

    <div class="form-group">
      <label for="author">작성자</label>
      <input type="text" id="author" name="author" required
             value="<%= post.author %>"
             placeholder="작성자명을 입력하세요">
    </div>

    <div class="form-group">
      <label for="htmlFile">HTML 파일</label>
      <div class="file-upload">
        <input type="file" id="htmlFile" name="htmlFile" accept=".html,.htm">
        <small>현재 파일: <%= post.original_name %> (변경하지 않으려면 비워두세요)</small>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-full">수정하기</button>
      <a href="/" class="btn btn-ghost btn-full">취소</a>
    </div>
  </form>
</div>

<%- include('footer') %>
