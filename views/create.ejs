<%- include('header') %>

<div class="form-page">
  <div class="form-header">
    <h1>새 글쓰기</h1>
    <p class="form-desc">HTML 파일을 업로드하여 게시글을 작성합니다</p>
  </div>

  <% if (typeof error !== 'undefined') { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/posts" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label for="title">제목</label>
      <input type="text" id="title" name="title" required
             value="<%= typeof title !== 'undefined' ? title : '' %>"
             placeholder="게시글 제목을 입력하세요">
    </div>

    <div class="form-group">
      <label for="author">작성자</label>
      <input type="text" id="author" name="author" required
             value="<%= typeof author !== 'undefined' ? author : '' %>"
             placeholder="작성자명을 입력하세요">
    </div>

    <div class="form-group">
      <label for="htmlFile">HTML 파일</label>
      <div class="file-upload">
        <input type="file" id="htmlFile" name="htmlFile" accept=".html,.htm" required>
        <small>HTML/HTM 파일만 업로드 가능 (최대 5MB)</small>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-full">등록하기</button>
      <a href="/" class="btn btn-ghost btn-full">취소</a>
    </div>
  </form>
</div>

<%- include('footer') %>
