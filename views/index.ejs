<%- include('header') %>

<div class="board-header">
  <h1>게시판</h1>
  <a href="/posts/new" class="btn btn-primary">글쓰기</a>
</div>

<table class="post-table">
  <thead>
    <tr>
      <th class="col-id">번호</th>
      <th class="col-title">제목</th>
      <th class="col-author">작성자</th>
      <th class="col-date">작성일</th>
      <th class="col-actions">관리</th>
    </tr>
  </thead>
  <tbody>
    <% if (posts.length === 0) { %>
      <tr><td colspan="5" class="empty">게시글이 없습니다.</td></tr>
    <% } %>
    <% posts.forEach(post => { %>
      <tr>
        <td class="col-id"><%= post.id %></td>
        <td class="col-title"><a href="/posts/<%= post.id %>" target="_blank"><%= post.title %></a></td>
        <td class="col-author"><%= post.author %></td>
        <td class="col-date"><%= post.created_at %></td>
        <td class="col-actions">
          <a href="/posts/<%= post.id %>/edit" class="btn btn-sm btn-secondary">수정</a>
          <form action="/posts/<%= post.id %>/delete" method="POST" class="inline-form"
                onsubmit="return confirm('��말 삭제하시겠습니까?')">
            <button type="submit" class="btn btn-sm btn-danger">삭���</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('footer') %>
