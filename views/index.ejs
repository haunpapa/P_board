<%- include('header') %>

<form class="toolbar" action="/" method="GET">
  <div class="search-input-wrap">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <input type="text" name="q" placeholder="제목으로 검색" value="<%= search %>">
  </div>
  <% if (search) { %>
    <a href="/" class="btn btn-ghost">초기화</a>
  <% } %>
  <a href="/posts/new" class="btn btn-primary">+ 새 글쓰기</a>
</form>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
        <polyline points="14 2 14 8 20 8"/>
        <line x1="16" y1="13" x2="8" y2="13"/>
        <line x1="16" y1="17" x2="8" y2="17"/>
      </svg>
    </div>
    <% if (search) { %>
      <p class="empty-title">"<%= search %>" 검색 결과가 없습니다</p>
      <p class="empty-sub">다른 키워드로 검색해보세요</p>
    <% } else { %>
      <p class="empty-title">아직 게시글이 없어요</p>
      <p class="empty-sub">첫 번째 글을 작성해보세요</p>
    <% } %>
  </div>
<% } else { %>
  <div class="card-grid">
    <% posts.forEach(post => { %>
      <div class="card">
        <a href="/posts/<%= post.id %>" target="_blank" class="card-link">
          <h2 class="card-title"><%= post.title %></h2>
          <span class="card-date"><%= post.created_at.split(' ')[0] %></span>
        </a>
        <div class="card-actions">
          <a href="/posts/<%= post.id %>/edit" class="card-btn">수정</a>
          <form action="/posts/<%= post.id %>/delete" method="POST" class="inline-form"
                onsubmit="return confirm('정말 삭제하시겠습니까?')">
            <button type="submit" class="card-btn card-btn-danger">삭제</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('footer') %>
